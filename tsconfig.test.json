{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "ES2020.BigInt", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist-test",
    "rootDir": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    // Every public subpath needs its own mapping: without one, tsc falls
    // back to package.json self-reference into dist/ — which exists
    // locally after a build but NOT in CI, where typecheck runs first
    // (first real CI run failed exactly there on 'zipnative/worker').
    "paths": {
      "zipnative": ["./src/index.ts"],
      "zipnative/worker": ["./src/worker/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "recipes/**/*.ts", "bench/**/*.ts"],
  "exclude": ["node_modules", "dist", "scripts"]
}
