# Normalize line endings to LF for all text files.
# CRITICAL for a ZIP library: a single autocrlf rewrite of a binary fixture
# silently corrupts offsets and CRCs (pdfnative lost 305–616 bytes of golden
# PDF fixtures to exactly this before adding the equivalent file).
* text=auto eol=lf

# Text files are LF in the repository AND in every working copy (eol=lf), so
# a Windows checkout produces the same bytes as CI and the byte manifests of
# generated files (llms, api.json, guides, rules) do not depend on the OS.

# Binary fixtures — never touched by line-ending conversion or diffed as text.
tests/fixtures/** binary
*.zip binary
*.jar binary
*.docx binary
*.xlsx binary
*.pptx binary
*.epub binary
*.vsix binary
*.png binary

# Generated files: collapsed in GitHub diffs and excluded from language stats.
docs/llms-full.txt      linguist-generated=true -diff
docs/llms-recipes.txt   linguist-generated=true
docs/llms-index.json    linguist-generated=true
docs/assets/api.json    linguist-generated=true
docs/guides/*.html      linguist-generated=true
.claude/rules/*.md      linguist-generated=true
package-lock.json       linguist-generated=true
