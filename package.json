{
  "name": "zipnative",
  "version": "1.0.0",
  "description": "Zero-dependency native ZIP engine: random-access reads without extracting, secure-by-default extraction (zip-slip, zip-bomb and header-ambiguity guards), true streaming, deterministic reproducible archives, and incremental modification without recompression. Pure TypeScript, one API across Node, browsers, Deno, Bun and Workers, built under a human-in-the-loop AI-agent governance policy.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "browser": {
        "types": "./dist/worker/index.d.ts",
        "default": "./dist/worker/index.js"
      },
      "import": {
        "types": "./dist/worker/index.d.ts",
        "default": "./dist/worker/index.js"
      },
      "require": {
        "types": "./dist/worker/index.d.cts",
        "default": "./dist/worker/index.cjs"
      }
    },
    "./worker/zip-worker.js": "./dist/worker/zip-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:interop": "npx tsx scripts/run-interop.ts",
    "validate:zip": "npx tsx scripts/validate-zip.ts",
    "test:generate": "npx tsx scripts/generate-samples.ts",
    "fixtures:generate": "npx tsx scripts/generate-fixtures.ts",
    "verify:docs": "npx tsx scripts/verify-docs.ts",
    "docs:api": "npx tsx scripts/build-api-json.ts",
    "docs:guides": "npx tsx scripts/build-guides.ts",
    "docs:llms": "npx tsx scripts/build-llms-full.ts",
    "docs:all": "npm run docs:api && npm run docs:guides && npm run docs:llms",
    "docs:playground": "node scripts/copy-playground-bundle.mjs",
    "docs:serve": "npx serve docs/ --listen 5000",
    "verify:issue": "node scripts/verify-issue.mjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts",
    "check:package": "npm run build && npx attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm && npx publint",
    "bench": "vitest bench",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zip",
    "unzip",
    "zip64",
    "archive",
    "compression",
    "decompression",
    "deflate",
    "inflate",
    "zero-dependency",
    "typescript",
    "streaming",
    "random-access",
    "incremental",
    "deterministic",
    "reproducible-builds",
    "zip-slip",
    "zip-bomb",
    "secure-by-default",
    "ooxml",
    "epub",
    "jar",
    "vsix",
    "serverless",
    "cloudflare-workers",
    "browser",
    "jszip-alternative",
    "fflate-alternative",
    "adm-zip-alternative",
    "ai-governance",
    "human-in-the-loop",
    "agent-safety"
  ],
  "author": "Nizoka <hello@pdfnative.dev> (https://pdfnative.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nizoka/zipnative.git"
  },
  "homepage": "https://github.com/Nizoka/zipnative#readme",
  "bugs": {
    "url": "https://github.com/Nizoka/zipnative/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://plika.app"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.8",
    "adm-zip": "^0.6.0",
    "eslint": "^9.0.0",
    "fflate": "^0.8.3",
    "jszip": "^3.10.1",
    "marked": "12.0.2",
    "publint": "^0.3.12",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
