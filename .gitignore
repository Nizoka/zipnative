node_modules/
dist/
dist-test/
dist-scripts/
coverage/
test-output/
*.tsbuildinfo
.DS_Store

# Release PR scratchpads live in release-notes/, never at the root
RELEASE_PR_*.md

# Agent-drafted issues (see .github/AGENT_RULES.md) — templates stay
.github/drafts/*
!.github/drafts/README.md
!.github/drafts/TEMPLATE.md

# Per-machine and secret files
.env
.env.*
*.log
Thumbs.db
.vscode/
.claude/settings.local.json

# npm pack / npm sbom write these to the root; the release workflow keeps its own copies
*.tgz
*.cdx.json
